# Cloudflare Workers settings for the commerce API (server/src/worker.mjs). Copy to wrangler.toml and fill the non-secret values.
# Secrets are NEVER written here — set each with `wrangler secret put NAME`:
#   SUPABASE_SERVICE_ROLE_KEY, SUPABASE_JWT_SECRET (or rely on the JWKS), TOSS_SECRET_KEY, OPENAI_API_KEY,
#   VAPID_PRIVATE_JWK, GOOGLE_SERVICE_ACCOUNT_JSON, LIVE_PAYMENTS_APPROVED (PRODUCTION only, set by the owner)
name = "yoonsiljang-commerce"
main = "src/worker.mjs"
compatibility_date = "2026-10-01"
compatibility_flags = ["nodejs_compat"]   # node:crypto X509Certificate (Apple), Buffer — check support before relying on it

[vars]
ENV = "SANDBOX"                            # DEMO | SANDBOX | PRODUCTION (PRODUCTION refuses to start without live keys + approval)
SUPABASE_URL = "https://<project>.supabase.co"
ALLOWED_ORIGINS = "https://lsy2825.github.io"
DATA_URL = "https://lsy2825.github.io/skin/data.json"
TOSS_CLIENT_KEY = "test_ck_..."            # a client key is public by design; the secret key is a secret
OPENAI_MODEL_DEFAULT = ""                  # set from the provider's current model list; checked against model_cost_config
OPENAI_MODEL_STRONG = ""
OPENAI_MODEL_TEXT = ""
AI_MAX_KRW_PER_JOB = "60"
VAPID_PUBLIC_KEY = ""
VAPID_SUBJECT = "mailto:<operator address>"
APPLE_BUNDLE_ID = ""
APPLE_ENVIRONMENT = "Sandbox"
GOOGLE_PLAY_PACKAGE = ""

[triggers]
crons = ["*/10 * * * *", "30 22 * * *"]    # every 10 min: reconcile payments + release stuck jobs; daily 07:30 KST: price watch after the data build
