// The PUBLIC Worker "yoonsiljang" (static assets, app/). PUBLIC HOSTING IS PAUSED since 2026-10-15 (owner's decision): the
// address keeps serving its last version. tools/factory.sh deploy() deploys this config only when the repository variable
// PUBLIC_DEPLOY is exactly "on" — do not run a bare `wrangler deploy` here by hand (this file is the default config at the
// repository root). The admin copy behind Cloudflare Access is cf/admin/wrangler.jsonc. Limits that matter: 25 MiB per file
// (data.json ≈ 15 MB), 20,000 files on the free plan (app/ has ~180).
{
  "$schema": "https://unpkg.com/wrangler@4.145.0/config-schema.json",
  "name": "yoonsiljang",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./app",
    "not_found_handling": "none"
  }
}
